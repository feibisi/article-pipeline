#!/usr/bin/env python3
"""Article pipeline CLI — compatibility shim.

There used to be TWO different CLIs with different behaviour:

  * this file — talked straight to TaskDB, so `add` bypassed both the topic
    dedup check and the topic-value filter, and it had no approve-outline
    (a TIER_EXTERNAL task added here could never be released);
  * article_pipeline.pipeline:main — the one pyproject actually installs
    (as `ap` / `article-pipeline`), which had no recover/status/skip.

README documented a mixture of the two. Everything now lives in
article_pipeline.pipeline:main; this file only translates the legacy flag
spellings so existing scripts and muscle memory keep working.

Canonical usage: `ap --help`
"""

import sys
from pathlib import Path

# Ensure the project root (containing article_pipeline/) is on sys.path
_project_root = str(Path(__file__).resolve().parent.parent)
if _project_root not in sys.path:
    sys.path.insert(0, _project_root)

from article_pipeline.pipeline import main  # noqa: E402

# Legacy subcommand spellings -> canonical ones
_COMMAND_ALIASES = {
    "review": "review-queue",
}


def _translate(argv: list[str]) -> list[str]:
    """Map the old flag style onto the canonical parser."""
    if not argv:
        return argv
    out = list(argv)
    cmd = out[0]
    out[0] = _COMMAND_ALIASES.get(cmd, cmd)

    if out[0] == "add":
        # old: add --keyword "X" --category tutorial --priority 1
        # new: add "X" -c tutorial -P 1
        keyword = None
        rest = []
        i = 1
        while i < len(out):
            tok = out[i]
            if tok == "--keyword" and i + 1 < len(out):
                keyword = out[i + 1]
                i += 2
                continue
            if tok.startswith("--keyword="):
                keyword = tok.split("=", 1)[1]
                i += 1
                continue
            rest.append(tok)
            i += 1
        if keyword is not None:
            out = ["add", keyword] + rest

    if out[0] == "list":
        # `list --status stuck` was a pseudo-status only this CLI understood.
        if "stuck" in out:
            print("Note: `list --status stuck` is now `ap recover --dry-run`.",
                  file=sys.stderr)
            return ["recover", "--dry-run"]

    return out


if __name__ == "__main__":
    sys.argv = [sys.argv[0]] + _translate(sys.argv[1:])
    main()
