#!/usr/bin/env python3
"""Article pipeline CLI — manage the article production pipeline.

Usage:
  article-pipeline add --keyword "xxx" --category wp-tech [--priority 1]
  article-pipeline list [--status queued|researching|outlining|writing|reviewing|done]
  article-pipeline status <task_id>
  article-pipeline run    # process next batch of queued tasks
  article-pipeline review # show articles ready for human review
  article-pipeline publish <task_id>
  article-pipeline skip <task_id> --reason "..."
"""

import sys
import argparse
from article_pipeline.db import init_db, TaskDB


def main():
    parser = argparse.ArgumentParser(description="Article Pipeline CLI")
    sub = parser.add_subparsers(dest="command")

    # add
    p_add = sub.add_parser("add")
    p_add.add_argument("--keyword", required=True)
    p_add.add_argument("--category", required=True, choices=["wp-tech", "book-knowledge"])
    p_add.add_argument("--platform", default="wptea")
    p_add.add_argument("--priority", type=int, default=1, choices=[1, 2, 3])

    # list
    p_list = sub.add_parser("list")
    p_list.add_argument("--status")
    p_list.add_argument("--category")

    # status
    p_status = sub.add_parser("status")
    p_status.add_argument("task_id", type=int)

    # run
    p_run = sub.add_parser("run")
    p_run.add_argument("--limit", type=int, default=5)

    # continue (resume from outline/writing stage)
    p_cont = sub.add_parser("continue")
    p_cont.add_argument("task_id", type=int)

    # review
    p_review = sub.add_parser("review")

    # publish
    p_pub = sub.add_parser("publish")
    p_pub.add_argument("task_id", type=int)

    # skip
    p_skip = sub.add_parser("skip")
    p_skip.add_argument("task_id", type=int)
    p_skip.add_argument("--reason", required=True)

    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        sys.exit(1)

    # Ensure DB exists
    db = TaskDB()

    if args.command == "add":
        task_id = db.add_task(args.keyword, args.category, args.platform, args.priority)
        print(f"Task #{task_id} added: {args.keyword} [{args.category}]")

    elif args.command == "list":
        tasks = db.list_tasks(status=args.status, category=args.category)
        print(f"{'ID':<5} {'Status':<14} {'P':<2} {'Category':<16} {'Keyword'}")
        print("-" * 70)
        for t in tasks:
            print(f"{t['id']:<5} {t['status']:<14} {t['priority']:<2} {t['category']:<16} {t['keyword']}")

    elif args.command == "status":
        task = db.get_task(args.task_id)
        if task:
            for k, v in task.items():
                print(f"{k}: {v}")
        else:
            print(f"Task #{args.task_id} not found.")

    elif args.command == "run":
        from article_pipeline.pipeline import Pipeline
        pipeline = Pipeline()
        pipeline.run(limit=args.limit)

    elif args.command == "continue":
        from article_pipeline.pipeline import Pipeline
        pipeline = Pipeline()
        pipeline.resume(args.task_id)

    elif args.command == "review":
        from article_pipeline.pipeline import Pipeline
        pipeline = Pipeline()
        pipeline.show_review_queue()

    elif args.command == "publish":
        from article_pipeline.pipeline import Pipeline
        pipeline = Pipeline()
        pipeline.publish(args.task_id)

    elif args.command == "skip":
        db.update_status(args.task_id, "skipped", {"skip_reason": args.reason})
        print(f"Task #{args.task_id} skipped: {args.reason}")


if __name__ == "__main__":
    main()
